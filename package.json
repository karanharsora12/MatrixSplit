{
  "name": "matrixsplit-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:backend": "npm --workspace=apps/backend run start:dev",
    "start:mobile": "npm --workspace=apps/mobile start"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
