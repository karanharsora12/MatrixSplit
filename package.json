{
  "name": "matrixsplit-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:backend": "npm --workspace=apps/backend run start:dev",
    "start:mobile": "npm --workspace=apps/mobile start"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "metro": "^0.80.12",
    "metro-config": "^0.80.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "react-native-svg": "15.2.0"
  }
}
