{
  "expo": {
    "name": "MatrixSplit",
    "slug": "matrixsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matrixsplit",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matrixsplit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10B981"
      },
      "package": "com.matrixsplit.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f6b7593-d76e-4ea6-a8d2-fdae03e2637a"
      }
    }
  }
}
