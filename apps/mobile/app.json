{
  "expo": {
    "name": "MatrixSplit",
    "slug": "matrixsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matrixsplit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matrixsplit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10B981"
      },
      "package": "com.matrixsplit.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
